# Production Environment Variables
# Copy this file to .env.production and update with your production values

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=your-sofia
POSTGRES_PORT=5432

# API Configuration
API_PORT=3000

# Payload CMS Secrets (MUST BE CHANGED IN PRODUCTION)
PAYLOAD_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING_32_CHARS
CRON_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING_32_CHARS
PREVIEW_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING_32_CHARS

# Server URL (Update with your domain)
NEXT_PUBLIC_SERVER_URL=https://your.sofia.bg

# Upstream OboApp base URL used for updates proxy routes
OBOAPP_UPDATES_BASE_URL=https://api.oboapp.online/v1

# API key for OboApp public API (sent as X-Api-Key upstream)
OBOAPP_API_KEY=CHANGE_ME_OBOAPP_API_KEY

# Node Environment
NODE_ENV=production

# Optional: Database backup retention (days)
BACKUP_RETENTION_DAYS=30

# Server and Edge runtimes read SENTRY_DSN; the browser bundle reads NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# Optional. Overrides the environment tag on Sentry events (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time only. Uploads source maps so production stack traces are readable.
# Never commit a real value.
SENTRY_AUTH_TOKEN=
